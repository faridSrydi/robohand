# =============================================================================
# Robotic Hand — Environment Variables (.env)
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# Gemini AI (Voice Assistant Robohand)
# Dapatkan API key gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Keamanan Sesi Login (WAJIB ganti dengan string acak panjang di VPS!)
# Generate di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ganti_dengan_secret_acak_minimal_32_karakter

# Database MySQL (menyimpan username & password bcrypt)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=robohand_app
MYSQL_PASSWORD=ganti_password_mysql_kamu
MYSQL_DATABASE=robotic_hand

# Akun login default yang otomatis dibuat saat pertama kali inisialisasi DB
DEFAULT_ADMIN_USER=robohand
DEFAULT_ADMIN_PASS=robohandti24

# Cloudflare Turnstile (checklist box verifikasi manusia di modal login)
# Buat widget di Cloudflare Dashboard -> Turnstile -> Add Widget (Domain: robotic-hand.my.id)
# Catatan: Di lokal (NODE_ENV != production), jika dibiarkan kosong akan otomatis memakai test key Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
